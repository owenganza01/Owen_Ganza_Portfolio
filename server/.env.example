# Copy this to .env and fill in your SMTP credentials
# For Gmail (less secure / app passwords) or any SMTP provider
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=your-smtp-password

# Where to send messages (optional). Defaults to SMTP_USER if omitted
TO_EMAIL=you@example.com

# Server port (optional)
PORT=3001
